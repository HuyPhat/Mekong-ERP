{
  "name": "@mekong-erp/erp-vue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --port 4174 --strictPort",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test",
    "budget": "node scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "@mekong-erp/contract": "workspace:*",
    "@tanstack/vue-query": "^5.104.0",
    "msw": "^2.15.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@mekong-erp/config": "workspace:*",
    "@mekong-erp/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vue-tsc": "^3.3.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
